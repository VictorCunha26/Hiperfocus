{
  "name": "hiperfocus",
  "private": true,
  "version": "1.0.0",
  "description": "Hiperfocus: textos e ilustrações personalizados a partir dos interesses de pessoas com TEA, para estimular a leitura.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:celular": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"vite --host\"",
    "dev:api": "node --watch-path=server server/index.js --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@google/genai": "^2.28.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
