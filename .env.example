# Chave gratuita do Google Gemini: crie em https://aistudio.google.com/apikey
# Sem ela, o app funciona em modo demonstração, com textos de exemplo.
GEMINI_API_KEY=

# Opcionais
# GEMINI_MODEL=gemini-3.8-flash   # modelo preferido (se falhar, o app tenta outros)
# HIPERFOCUS_DEMO=1               # força o modo demonstração, mesmo com chave
# PORT=3001                       # porta do servidor em produção (npm start)
